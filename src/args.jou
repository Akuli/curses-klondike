# This file parses command-line arguments.

import "stdlib/argparse.jou"
import "stdlib/ascii.jou"
import "stdlib/io.jou"
import "stdlib/str.jou"
import "stdlib/process.jou"
import "./state.jou"


def is_valid_integer(s: byte*, min: int, max: int) -> bool:
    if *s == '\0':
        return False

    for p = s; *p != '\0'; p++:
        if not is_ascii_digit(*p):
            return False

    # This won't work for very large values, but it doesn't really matter :)
    n = atoi(s)
    return min <= n and n <= max


@public
def parse_args(argv: byte**) -> Args:
    args = Args{color = True, pick = 3, discardhide = False}
    parser = ArgumentParser{argv = argv}

    while parser.next():
        match parser.flag with strcmp:
            case "--help":
                printf("Usage: %s [--help] [--no-colors] [--pick n] [--discard-hide]\n", argv[0])
                printf("\n")
                printf("Options:\n")
                printf("  --help          show this help message and exit\n")
                printf("  --no-colors     don't use colors, even if the terminal supports colors\n")
                printf("  --pick n        pick n cards from stock at a time, default is 3\n")
                printf("  --discard-hide  only show topmost discarded card (not useful with --pick=1)\n")
                exit(0)
            case "--no-color" | "--no-colors":
                args.color = False
            case "--pick":
                s = parser.take_value()
                if s == NULL:
                    fprintf(get_stderr(), "%s: use '--pick something' or '--pick=something', not just '--pick' (try --help)\n", argv[0])
                    exit(2)
                pick_max = 13*4 - (1+2+3+4+5+6+7)
                if not is_valid_integer(s, 1, pick_max):
                    fprintf(get_stderr(), "%s: '--pick' wants an integer between 1 and %d, not '%s' (try --help)\n", argv[0], pick_max, s)
                    exit(2)
                args.pick = atoi(s)
            case "--discard-hide":
                args.discardhide = True
            case "":
                fprintf(get_stderr(), "%s: unexpected argument: '%s' (try --help)\n", argv[0], parser.take_value())
                exit(2)
            case _:
                fprintf(get_stderr(), "%s: unknown option '%s' (try --help)\n", argv[0], parser.flag)
                exit(2)

        if parser.pending_value != NULL:
            fprintf(get_stderr(), "%s: use just '%s', not '%s something' or '%s=something' (try --help)\n", argv[0], parser.flag, parser.flag, parser.flag)
            exit(2)

    return args


# Main function for tests: `jou -o foo src/args.jou` compiles an executable that runs this.
def main(argc: int, argv: byte**) -> int:
    args = parse_args(argv)
    args.print()
    return 0
